#!/usr/bin/env bash
# Rodar localmente (precisa de docker, conftest|opa, syft, trivy, cosign e login no ghcr.io).
# Gera os artefatos que o sandbox não conseguiu produzir: SBOM do Syft, print do Trivy e assinatura keyless do Cosign.
set -euo pipefail
cd "$(dirname "$0")/.."
REG="${REG:-ghcr.io/tiagopelles}"
BEFORE="$REG/api-brinquedo:before"; AFTER="$REG/api-brinquedo:after"
mkdir -p evidence

echo "== 1. POLÍTICA (Rego) =="
conftest test Dockerfile.before --policy policy || true      # esperado: 3 falhas
conftest test Dockerfile        --policy policy               # esperado: passa
# alternativa só com opa:
# python3 scripts/dockerfile2json.py Dockerfile.before > /tmp/in.json
# opa eval -f pretty -d policy/dockerfile.rego -i /tmp/in.json 'data.main.deny'
# opa test policy/ -v

echo "== 2. INVENTÁRIO (Syft + Trivy) =="
docker build -f Dockerfile.before -t "$BEFORE" .
docker build -f Dockerfile        -t "$AFTER"  .
syft "$BEFORE" -o cyclonedx-json=evidence/sbom-syft-before.cdx.json
syft "$AFTER"  -o cyclonedx-json=evidence/sbom-syft-after.cdx.json
trivy image --severity HIGH,CRITICAL "$BEFORE" | tee evidence/trivy-BEFORE.txt
trivy image --severity HIGH,CRITICAL "$AFTER"  | tee evidence/trivy-AFTER.txt
trivy sbom evidence/sbom-syft-before.cdx.json  | tee evidence/trivy-sbom-BEFORE.txt   # RV.1.3: SBOM x CVEs
# >>> tira o print de evidence/trivy-BEFORE.txt (procure lodash 4.17.15) <<<

echo "== 3. CADEIA (Cosign keyless) =="
docker push "$AFTER"
DIGEST=$(docker inspect --format '{{index .RepoDigests 0}}' "$AFTER")      # assina o DIGEST, não a tag
cosign sign --yes "$DIGEST"                                                  # abre o navegador (OIDC/Fulcio) e registra no Rekor
cosign attest --yes --type cyclonedx --predicate evidence/sbom-syft-after.cdx.json "$DIGEST"   # SBOM atestado
IDENT="${COSIGN_IDENTITY:-pelles.tiago@gmail.com}"; ISS="${COSIGN_ISSUER:-https://accounts.google.com}"
cosign verify "$DIGEST" --certificate-identity "$IDENT" --certificate-oidc-issuer "$ISS" | tee evidence/cosign-verify-OK.txt

echo "== Ataque: tag adulterada (imagem trocada) =="
docker build -f Dockerfile.before -t "$AFTER" .           # atacante republica a MESMA tag com conteúdo diferente
docker push "$AFTER"
NEW=$(docker inspect --format '{{index .RepoDigests 0}}' "$AFTER")
cosign verify "$NEW" --certificate-identity "$IDENT" --certificate-oidc-issuer "$ISS" 2>&1 | tee evidence/cosign-verify-ADULTERADA.txt || echo "BLOQUEADO: sem assinatura válida"
